# DeepBl4nder Worker — Blender + FFmpeg headless (GPU)
#
# Usage:
#   docker build -t deepbl4nder-worker:latest -f Dockerfile.worker .
#   docker run --rm --gpus all -v $(pwd)/work:/work deepbl4nder-worker:latest

# ── Stage 1: builder — install Python deps ───────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /build
COPY pyproject.toml README.md ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir --no-deps . || true

COPY DeepBl4nder/ DeepBl4nder/
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir .

# ── Stage 2: runtime — CUDA + Blender + FFmpeg ───────────────────────
FROM nvidia/cuda:12.9.2-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    TZ=Etc/UTC

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Install Python 3.12 + system dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       gnupg \
       software-properties-common \
       curl \
       ca-certificates \
       xz-utils \
       ffmpeg \
       libxkbcommon0 \
       libdbus-1-3 \
       libglib2.0-0 \
       libgl1 \
       libglu1-mesa \
       libxrender1 \
       libxext6 \
       libxi6 \
       libxfixes3 \
       libxcb1 \
       libx11-6 \
       libsm6 \
       libice6 \
       libxxf86vm1 \
       libfontconfig1 \
       libfreetype6 \
       libxrandr2 \
       libxcursor1 \
       libxinerama1 \
       libgomp1 \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       python3.12 \
       python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Install Blender 4.1 (LTS)
ARG BLENDER_VERSION=4.1.1
ARG BLENDER_URL=https://download.blender.org/release/Blender4.1/blender-${BLENDER_VERSION}-linux-x64.tar.xz

RUN curl -fsSL --retry 3 --retry-delay 5 --connect-timeout 30 "$BLENDER_URL" -o /tmp/blender.tar.xz \
    && tar -xf /tmp/blender.tar.xz -C /opt \
    && ln -s /opt/blender-${BLENDER_VERSION}-linux-x64 /opt/blender \
    && ln -s /opt/blender/blender /usr/local/bin/blender \
    && rm /tmp/blender.tar.xz

# Create work directories
RUN mkdir -p /work /projects

# Non-root user
RUN groupadd -r deepbl4nder && useradd -r -g deepbl4nder -d /app -s /sbin/nologin deepbl4nder \
    && chown -R deepbl4nder:deepbl4nder /app \
    && chown -R deepbl4nder:deepbl4nder /work \
    && chown -R deepbl4nder:deepbl4nder /projects
USER deepbl4nder

WORKDIR /work

ENV BLENDER_EXE=/usr/local/bin/blender \
    FFMPEG_EXE=/usr/local/bin/ffmpeg \
    PYTHONPATH=/app:/work \
    DeepBl4nder_WORKER=1 \
    PYTHONUNBUFFERED=1 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD blender --version && ffmpeg -version > /dev/null 2>&1

CMD ["python3.12", "-c", "import time; print('DeepBl4nder worker ready'); time.sleep(86400)"]
