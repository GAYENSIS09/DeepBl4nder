# DeepBlender Worker — Blender headless execution environment
#
# Usage:
#   docker build -t deepblender/worker:latest .
#   docker run --rm -v $(pwd)/work:/work deepblender/worker:latest \
#     blender -b -P /work/script.py

FROM python:3.12-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    libglib2.0-0 \
    libgl1 \
    libxrender1 \
    libxext6 \
    libxi6 \
    libxfixes3 \
    libxcb1 \
    libx11-6 \
    libsm6 \
    libice6 \
    libxxf86vm1 \
    libfontconfig1 \
    libfreetype6 \
    && rm -rf /var/lib/apt/lists/*

# Install Blender 4.1 (LTS) from official tarball
ARG BLENDER_VERSION=4.1.1
ARG BLENDER_URL=https://download.blender.org/release/Blender4.1/blender-${BLENDER_VERSION}-linux-x64.tar.xz

RUN curl -fsSL "${BLENDER_URL}" -o /tmp/blender.tar.xz \
    && tar -xf /tmp/blender.tar.xz -C /opt \
    && ln -s /opt/blender-${BLENDER_VERSION}-linux-x64 /opt/blender \
    && ln -s /opt/blender/blender /usr/local/bin/blender \
    && rm /tmp/blender.tar.xz

# Verify Blender installation
RUN blender --version

# Install Python dependencies (DeepBlender + NOOA)
WORKDIR /app

# Copy only dependency files first for better caching
COPY pyproject.toml README.md ./
COPY deepblender/ deepblender/

# Install in editable mode with all extras
RUN pip install --no-cache-dir -e ".[worker]"

# Create work directory
RUN mkdir -p /work

# Default working directory
WORKDIR /work

# Environment variables for worker
ENV BLENDER_EXE=/usr/local/bin/blender
ENV PYTHONPATH=/app:/work
ENV DEEPBLENDER_WORKER=1

# Health check: verify Blender can run a minimal script
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD blender -b -P -c "import bpy; print('Blender OK:', bpy.app.version_string)" 2>&1 | grep -q "Blender OK"

# Default command: wait for work (override with docker run args)
ENTRYPOINT ["blender"]
CMD ["-b", "-P", "/work/script.py"]