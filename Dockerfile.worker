# DeepBl4nder Worker — Blender + FFmpeg headless execution environment
#
# Usage:
#   docker build -t DeepBl4nder/worker:latest -f Dockerfile.worker .
#   docker run --rm -v $(pwd)/work:/work DeepBl4nder/worker:latest \
#     blender -b -P /work/script.py

FROM python:3.12-slim

# System dependencies (X11, OpenGL, FFmpeg)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    xz-utils \
    ffmpeg \
    libxkbcommon0 \
    libdbus-1-3 \
    libglib2.0-0 \
    libgl1 \
    libglu1-mesa \
    libxrender1 \
    libxext6 \
    libxi6 \
    libxfixes3 \
    libxcb1 \
    libx11-6 \
    libsm6 \
    libice6 \
    libxxf86vm1 \
    libfontconfig1 \
    libfreetype6 \
    libxrandr2 \
    libxcursor1 \
    libxinerama1 \
    && rm -rf /var/lib/apt/lists/*

# Install Blender 4.1 (LTS) from official tarball with retries and fallback mirror
ARG BLENDER_VERSION=4.1.1
ARG BLENDER_URL=https://download.blender.org/release/Blender4.1/blender-${BLENDER_VERSION}-linux-x64.tar.xz
ARG BLENDER_MIRROR=https://mirror.clarkson.edu/blender/release/Blender4.1/blender-${BLENDER_VERSION}-linux-x64.tar.xz

RUN for url in "${BLENDER_URL}" "${BLENDER_MIRROR}"; do \
      echo "Trying $url..." && \
      curl -fsSL --retry 3 --retry-delay 5 --connect-timeout 30 "$url" -o /tmp/blender.tar.xz && break; \
    done \
    && tar -xf /tmp/blender.tar.xz -C /opt \
    && ln -s /opt/blender-${BLENDER_VERSION}-linux-x64 /opt/blender \
    && ln -s /opt/blender/blender /usr/local/bin/blender \
    && rm /tmp/blender.tar.xz

# Verify Blender installation
RUN blender --version

# Python dependencies
WORKDIR /app
COPY pyproject.toml README.md ./
COPY DeepBl4nder/ DeepBl4nder/
RUN pip install --no-cache-dir ".[worker]"

# Create work directory
RUN mkdir -p /work /projects

# Non-root user
RUN groupadd -r DeepBl4nder && useradd -r -g DeepBl4nder -d /app -s /sbin/nologin DeepBl4nder \
    && chown -R DeepBl4nder:DeepBl4nder /app \
    && chown -R DeepBl4nder:DeepBl4nder /work \
    && chown -R DeepBl4nder:DeepBl4nder /projects
USER DeepBl4nder

WORKDIR /work

ENV BLENDER_EXE=/usr/local/bin/blender \
    FFMPEG_EXE=/usr/local/bin/ffmpeg \
    PYTHONPATH=/app:/work \
    DeepBl4nder_WORKER=1 \
    PYTHONUNBUFFERED=1

# Health check: verify Blender and FFmpeg are available
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD blender --version && ffmpeg -version > /dev/null 2>&1

CMD ["blender", "-b", "-P", "/work/script.py"]
