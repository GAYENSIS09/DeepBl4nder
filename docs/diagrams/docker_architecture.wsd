@startuml
!define RECTANGLE class

skinparam backgroundColor #0A0A0A
skinparam componentStyle rectangle
skinparam rectangle {
    BackgroundColor #121212
    BorderColor #AAFF00
    ArrowColor #AAFF00
    FontColor #F2F2F2
    FontSize 12
}
skinparam arrow {
    Color #AAFF00
    FontColor #F2F2F2
}

title DeepBl4nder — Docker Compose Architecture

node "Host Machine" {
    package "docker compose up -d" {
        [docker-compose.yml] as Compose
    }
}

package "Services" {
    [llm-server:8080\nOPTIONNEL — llama.cpp + Qwen3\nLocal (inférence locale)] as LLM
    [blender-worker\nBlender 4.1 + FFmpeg\nGPU: NVIDIA] as Blender
    [tui (profil tui)\nInterface Textual] as TUI
}

package "Host Volumes" {
    [./models → /models\nGGUF (locale optionnelle)] as VolModels
    [./work → /work\nScripts Blender] as VolWork
    [./projects → /projects\nProjets] as VolProjects
    [./output → /output\nRendus finaux] as VolOutput
}

' Connections
Compose --> LLM
Compose --> Blender
Compose --> TUI

LLM --> VolModels : Read GGUF
Blender --> VolWork : Scripts
Blender --> VolProjects : Assets
Blender --> VolOutput : Renders

' Network
LLM ..> Blender : HTTP :8080 (llm-server local)

' TUI
TUI --> LLM : HTTP localhost:8080 (si llm-server)

legend right
    | Service | Port | GPU | Profile |
    | llm-server (optionnel) | 8080 | Oui | Core |
    | blender-worker | — | Oui | Core |
    | TUI | Local | Non | tui |
endlegend

@enduml