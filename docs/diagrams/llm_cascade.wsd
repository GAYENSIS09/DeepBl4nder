@startuml
!define RECTANGLE class

skinparam backgroundColor #0A0A0A
skinparam componentStyle rectangle
skinparam rectangle {
    BackgroundColor #121212
    BorderColor #AAFF00
    ArrowColor #AAFF00
    FontColor #F2F2F2
    FontSize 12
}
skinparam arrow {
    Color #AAFF00
    FontColor #F2F2F2
}

title DeepBl4nder — Routeur LLM Cloud (litellm)

package "Agent" {
    [Agent Request] as Request
}

package "LLMRouter (litellm)" {
    [Router\nFallback / Vote] as Router
}

package "Fournisseurs Cloud" {
    [Gemini] as G
    [Groq] as Gr
    [NVIDIA] as Nv
    [OpenRouter] as Or
    [Cloudflare] as Cf
}

package "Observabilité" {
    [Santé / Cooldown\n/ Budget USD] as Health
}

' Flow
Request --> Router : UnifiedLLM (acall)
Router --> G : 1er fournisseur sain
Router --> Gr
Router --> Nv
Router --> Or
Router --> Cf

G --> Router : SUCCESS
Gr --> Router : SUCCESS
Nv --> Router : SUCCESS
Or --> Router : SUCCESS
Cf --> Router : SUCCESS

' Failover
G -.-> Router : échec (cooldown)
Router -.-> Gr : fallback
Gr -.-> Router : échec (cooldown)
Router -.-> Nv : fallback

Router --> Health : enregistre succès/échecs
Router --> Request : Final Response

legend right
    | Couleur | Fournisseur |
    | <back:#AAFF00><color:#0A0A0A> ■ </color></back> | Gemini (GEMINI_API_KEY) |
    | <back:#88CC00><color:#0A0A0A> ■ </color></back> | Groq (GROQ_API_KEY) |
    | <back:#E6C229><color:#0A0A0A> ■ </color></back> | NVIDIA (NVIDIA_API_KEY) |
    | <back:#61AFEF><color:#0A0A0A> ■ </color></back> | OpenRouter (OPENROUTER_API_KEY) |
    | <back:#56B6C2><color:#0A0A0A> ■ </color></back> | Cloudflare (CLOUDFLARE_API_KEY) |
endlegend

@enduml
