# DeepBlender — variables d'environnement
# Copier vers `.env` et remplir les valeurs. NE JAMAIS committer `.env`.
# Ce fichier `.env.example` ne contient aucun secret.

# Fournisseurs LLM (seule la clé d'API est lue depuis .env)
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=   # requis pour le fournisseur cloudflare (compte Workers AI)
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# LLM_API_KEY=   # clé pour un serveur local compatible OpenAI (ex. Ollama/LM Studio)

# Le pool et les modèles sont définis en dur dans deepblender/llm.py (PROVIDERS).
# Sélection du pool : LLMRouter(provider_ids=[...]) ; par défaut tous les
# fournisseurs dont la clé ci-dessus est définie.


# Budget par production (USD)
DEEPBLENDER_BUDGET=1.0

# NOOA 0.0.8 — capacités exploitées (voir docs/architecture/00-nooa.md)
# DEEPBLENDER_AGENT_TRUNCATION=1    # active TruncationConfig (gestion de contexte multi-tours)
# LLM_CONTEXT_TOKENS=64000          # budget de contexte (défaut quand activé)
# LLM_EVENT_TOKENS=                 # budget d'événements (optionnel)
# DEEPBLENDER_AGENT_STORAGE=        # chemin SQLite pour persister l'état des agents (ex. ./data/agents.db)
# DEEPBLENDER_TRACING=1             # active le tracing NOOA (viewer OTLP sur localhost:5001)

# Binaires externes (optionnel ; défauts ci-dessous)
BLENDER_EXE=blender
FFMPEG_EXE=ffmpeg
GIT_EXE=git

# CORS frontend (gateway HTTP)
DEEPBLENDER_CORS_ORIGINS=http://localhost:3000

# Binaires externes (optionnel ; auto-détection sinon)
# Sur Windows, si Blender n'est pas sur le PATH :
# BLENDER_EXE=C:\Program Files\Blender Foundation\Blender 5.1\blender.exe
# FFMPEG_EXE=ffmpeg
